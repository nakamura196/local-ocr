# 公証（macOS）に要る App Store Connect API の資格情報。
#
# **実値は書かない。** 1Password の項目への参照だけを書き、使うときに注入する。
#
#   cp .env.example .env     # <item-name> を自分の項目名に直す
#   op run --env-file=.env -- ./scripts/notarize.zsh
#   op run --env-file=.env -- ./scripts/release.zsh
#
# APP_STORE_API_KEY には秘密鍵そのものではなく **Key ID** を入れる。
# 鍵の本体（.p8）は ~/.private_keys/AuthKey_<KEY_ID>.p8 に置く
# （notarytool がその場所を見る）。
APP_STORE_API_KEY=op://Personal/<item-name>/app_store_api_key
APP_STORE_API_ISSUER=op://Personal/<item-name>/app_store_api_issuer
